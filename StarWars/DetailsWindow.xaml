<Window x:Class="StarWars.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarWars"
        mc:Ignorable="d"
        Icon="./images/star_wars.ico"
        Background="Black"
        Title="Szereplő" SizeToContent="Height" Width="300">
    <Border Background="Yellow" Margin="10" CornerRadius="10">
        <StackPanel Margin="10">
            <Image Source="https://vignette.wikia.nocookie.net/starwars/images/2/20/LukeTLJ.jpg"/>
            <TextBlock Text="Luke Skywalker" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
