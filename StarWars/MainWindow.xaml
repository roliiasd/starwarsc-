<Window x:Class="StarWars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarWars"
        mc:Ignorable="d"
        Icon="./images/star_wars.ico"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        BorderBrush="Yellow"
        BorderThickness="5"
        Title="Star Wars" Height="450" Width="450">
    <StackPanel Margin="20">
        <Image Source="./images/star_wars_logo.png"/>
        <Button Name="gomb" Content="Szereplők betöltése" Margin="0 20 0 20" Padding="5" Background="Yellow" FontSize="20" FontWeight="Bold"/>
    </StackPanel>
</Window>
